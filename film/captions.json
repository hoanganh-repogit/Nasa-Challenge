[
  {
    "start": 0.3,
    "end": 1.97,
    "text": "Built for ninety Martian days,"
  },
  {
    "start": 1.99,
    "end": 3.21,
    "text": "Opportunity kept going"
  },
  {
    "start": 3.23,
    "end": 4.83,
    "text": "for over fourteen years."
  },
  {
    "start": 4.9,
    "end": 6.83,
    "text": "This light is its real route,"
  },
  {
    "start": 6.85,
    "end": 8.18,
    "text": "from NASA's records."
  },
  {
    "start": 8.2,
    "end": 10.07,
    "text": "In 2005, a sand dune trapped"
  },
  {
    "start": 10.09,
    "end": 12.22,
    "text": "it for more than five weeks."
  },
  {
    "start": 12.4,
    "end": 14.84,
    "text": "At Esperance, its arm ground into a rock,"
  },
  {
    "start": 14.86,
    "end": 16.650000000000002,
    "text": "then read what it was made of:"
  },
  {
    "start": 16.67,
    "end": 18.96,
    "text": "clay minerals, from gentler water."
  },
  {
    "start": 20.3,
    "end": 23.52,
    "text": "In June 2018, a dust storm blocked the Sun."
  },
  {
    "start": 23.54,
    "end": 26.49,
    "text": "The solar-powered rover fell silent."
  },
  {
    "start": 26.8,
    "end": 28.06,
    "text": "Echoes of the Cosmos."
  },
  {
    "start": 28.08,
    "end": 29.84,
    "text": "Follow the whole journey."
  }
]
